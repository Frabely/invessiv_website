{
  "manifest_version": 3,
  "name": "Invessiv Profile Bridge",
  "version": "0.1.0",
  "description": "Liefert Instagram- und LinkedIn-Profildaten aus dem eingeloggten Browser an den Invessiv Workspace.",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.linkedin.com/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3001/*", "https://workspace.invessiv.com/*"]
  }
}
