# Clerk – Keys aus https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Owner-Bootstrap: Clerk-User-ID (user_...), die beim ersten Login zum ersten Workspace-Owner wird.
# Wirkt nur, solange kein aktiver Owner existiert. E-Mail-Adressen gewähren nie Zugriff.
WORKSPACE_BOOTSTRAP_CLERK_USER_ID=user_xxx

# Kundenportal (Ordner 12a/12b): "true" schaltet Portalrouten und Portal-API frei. Jeder andere
# Wert (auch fehlend) hält das Portal unsichtbar — 404 auf jeder Portalroute.
FEATURE_PORTAL_ENABLED=false

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Public URLs (Fallbacks sind Production-Defaults)
NEXT_PUBLIC_APP_URL=https://workspace.invessiv.com
NEXT_PUBLIC_MARKETING_URL=https://invessiv.com

# OpenAI (OPENAI_MODEL ist optional, nutzt Default wenn nicht gesetzt)
OPENAI_API_KEY=openai-api-key
OPENAI_MODEL=gpt-4.1-mini
