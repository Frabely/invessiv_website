# Clerk – Keys aus https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Workspace-Allowlist (kommagetrennte E-Mail-Adressen, kein Leerzeichen)
WORKSPACE_ALLOWED_EMAILS=you@example.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Public URLs (Fallbacks sind Production-Defaults)
NEXT_PUBLIC_APP_URL=https://workspace.invessiv.com
NEXT_PUBLIC_MARKETING_URL=https://invessiv.com

# OpenAI (OPENAI_MODEL ist optional, nutzt Default wenn nicht gesetzt)
OPENAI_API_KEY=openai-api-key
OPENAI_MODEL=gpt-4.1-mini
