# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Contact mail
CONTACT_MAIL_PROVIDER=resend
CONTACT_MAIL_FROM=Invessiv <noreply@example.com>
CONTACT_MAIL_TO=contact@example.com
RESEND_API_KEY=re_xxx

# LinkedIn post generator
OPENAI_API_KEY=openai-api-key
OPENAI_MODEL=gpt-5.5

# Public site URL (used for canonical, OG, sitemap).
# MUST match the primary host that actually serves traffic (incl. www/non-www),
# otherwise canonical/hreflang/sitemap point at a redirect and pages stay unindexed.
NEXT_PUBLIC_SITE_URL=https://www.invessiv.com

# Google Search Console verification (either variable is accepted)
GOOGLE_SITE_VERIFICATION=

# Google Tag (only loaded on the landing + landing success route, Consent Mode v2).
# Leave empty to disable the tag entirely (graceful no-op).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-5T4BC28Z0F
# Google Ads conversion (event-based "Google tag" conversion, fired on the success route).
# ID  = Google Ads conversion/tag id; loads the AW destination so the event is attributed.
# EVENT = the event name from the conversion action's event snippet
#         (gtag('event','ads_conversion_<Name>_<n>', {...})).
# The conversion only fires when BOTH id and event are set; leave empty to disable (no-op).
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-18232244710
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_EVENT=ads_conversion_Angebot_anfordern_1

# Feature flags
ENABLE_MARKETING_PROOF=false

GENERATOR_USAGE_LIMIT_SECRET=3fde2597a7890fa3aafe710c589f9130ec35887a29b530c51f60c59e8f05d857
# Local/dev-only opt-in. Omit or set to false outside development.
LINKEDIN_POST_GENERATOR_USE_MOCK=false
