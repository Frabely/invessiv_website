{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/common/*": ["./common/*"],
      "@invessiv/common": ["../../packages/common/src/index.ts"],
      "@invessiv/common/*": ["../../packages/common/src/*"],
      "@invessiv/db": ["../../packages/db/src/index.ts"],
      "@invessiv/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
