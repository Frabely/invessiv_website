{
  "name": "pnpm-invessiv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "db:migrate": "pnpm --filter @invessiv/db db:migrate",
    "db:migrate:dev": "pnpm --filter @invessiv/db db:migrate:dev",
    "db:migrate:preview": "pnpm --filter @invessiv/db db:migrate:preview",
    "db:migrate:prod": "pnpm --filter @invessiv/db db:migrate:prod",
    "db:reset:dev": "pnpm --filter @invessiv/db db:reset:dev",
    "db:smoke": "pnpm --filter @invessiv/db db:smoke",
    "db:smoke:dev": "pnpm --filter @invessiv/db db:smoke:dev",
    "db:smoke:preview": "pnpm --filter @invessiv/db db:smoke:preview",
    "db:smoke:prod": "pnpm --filter @invessiv/db db:smoke:prod",
    "db:seed:leads": "pnpm --filter @invessiv/db db:seed:leads",
    "dev": "next dev",
    "dev:web": "pnpm --filter @invessiv/web dev",
    "build": "next build",
    "build:web": "pnpm --filter @invessiv/web build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e:contact": "playwright test e2e/contact-lead-persistence.e2e.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@clerk/localizations": "^4.5.6",
    "@clerk/nextjs": "^7.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@invessiv/common": "workspace:*",
    "@invessiv/db": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "openai": "^6.38.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.72.1",
    "server-only": "^0.0.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lhci/cli": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "latest",
    "jsdom": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "latest"
  }
}
