{
  "name": "pnpm-invessiv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "db:migrate": "pnpm --filter @invessiv/db db:migrate",
    "db:migrate:dev": "pnpm --filter @invessiv/db db:migrate:dev",
    "db:migrate:preview": "pnpm --filter @invessiv/db db:migrate:preview",
    "db:migrate:prod": "pnpm --filter @invessiv/db db:migrate:prod",
    "db:reset:dev": "pnpm --filter @invessiv/db db:reset:dev",
    "db:smoke": "pnpm --filter @invessiv/db db:smoke",
    "db:smoke:dev": "pnpm --filter @invessiv/db db:smoke:dev",
    "db:smoke:preview": "pnpm --filter @invessiv/db db:smoke:preview",
    "db:smoke:prod": "pnpm --filter @invessiv/db db:smoke:prod",
    "db:seed:leads": "pnpm --filter @invessiv/db db:seed:leads",
    "dev:web": "pnpm --filter @invessiv/web dev",
    "dev:workspace": "pnpm --filter @invessiv/workspace dev",
    "build:web": "pnpm --filter @invessiv/web build",
    "build:workspace": "pnpm --filter @invessiv/workspace build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@lhci/cli": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "next": "16.1.6",
    "husky": "latest",
    "jsdom": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "latest"
  }
}
