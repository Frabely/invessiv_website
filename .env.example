# Clerk public/runtime configuration
# Get these from https://dashboard.clerk.com -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk auth routes
# Keep these path-neutral; app code adds the active locale where needed.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

# Workspace allowlist
# Comma-separated lowercase email addresses without whitespace.
WORKSPACE_ALLOWED_EMAILS=you@example.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Contact mail
CONTACT_MAIL_PROVIDER=resend
CONTACT_MAIL_FROM=Invessiv <noreply@example.com>
CONTACT_MAIL_TO=contact@example.com
RESEND_API_KEY=re_xxx

# Feature flags
ENABLE_MARKETING_PROOF=false

# Local tooling
NX_DAEMON=false
TURBO_CACHE=local
TURBO_DOWNLOAD_LOCAL_ENABLED=false
TURBO_REMOTE_ONLY=false
TURBO_RUN_SUMMARY=true

# Vercel runtime-managed values
# These are normally provided by Vercel and should not contain real values here.
VERCEL=1
VERCEL_ENV=development
VERCEL_TARGET_ENV=development
VERCEL_URL=example.vercel.app
VERCEL_OIDC_TOKEN=runtime-managed

# Vercel git metadata
VERCEL_GIT_PROVIDER=github
VERCEL_GIT_REPO_OWNER=example-owner
VERCEL_GIT_REPO_SLUG=example-repo
VERCEL_GIT_REPO_ID=runtime-managed
VERCEL_GIT_COMMIT_REF=main
VERCEL_GIT_COMMIT_SHA=runtime-managed
VERCEL_GIT_PREVIOUS_SHA=runtime-managed
VERCEL_GIT_COMMIT_MESSAGE=runtime-managed
VERCEL_GIT_COMMIT_AUTHOR_LOGIN=runtime-managed
VERCEL_GIT_COMMIT_AUTHOR_NAME=runtime-managed
VERCEL_GIT_PULL_REQUEST_ID=

# AI model provider
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=openai-api-key

# LinkedIn post generator usage limiting
# Use a long random server-only value. Changing it resets pseudonymous usage keys.
GENERATOR_USAGE_LIMIT_SECRET=replace-with-long-random-secret

# Signs the deliver token for the gated "post per E-Mail schicken" step.
# Long random server-only value. Changing it invalidates outstanding deliver tokens.
GENERATOR_DELIVERY_TOKEN_SECRET=replace-with-long-random-secret
